# =============================================================================
# Shield Labs Bot - Environment Configuration Example
# Copy this file to .env and provide your actual secrets/keys.
# =============================================================================

# Google Gemini API Key for Cyber Threat Intelligence & AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Cloud Database & Real-Time Telemetry Sync
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here

# Local Service Port (Default: 3000)
PORT=3000

# App hosting URL (Used for self-referential links, agent pairings, and API callbacks)
APP_URL=http://localhost:3000
